
# 프로젝트 루트의 .env로 복사한 뒤 개인 로컬 환경에 맞게 입력합니다.
# 실제 비밀번호와 비밀키는 이 예시 파일에 작성하지 않습니다.

# Database: 실행 중인 MySQL의 DB 이름과 접속 계정에 맞게 수정.
DB_URL=jdbc:mysql://localhost:3306/ttareureung
DB_USERNAME=root
DB_PASSWORD=

# JWT: openssl rand -base64 32로 생성한 비밀키를 입력.
JWT_SECRET=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# CORS: 여러 Origin은 쉼표로 구분.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 초대 링크에 들어갈 프론트 주소.
FRONTEND_BASE_URL=http://localhost:5173

# Gemini: Google AI Studio에서 발급한 API 키. 처방전 인식과 약 판독에 사용. 모델명은 선택(기본 gemini-3.5-flash-lite).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 사진 저장소: S3 버킷·IAM 키가 있으면 S3, 비워 두면 서버 디스크(FILE_STORAGE_DIR, 기본 임시 폴더)에 저장.
# PUBLIC_BASE_URL은 디스크 저장 시 사진 링크의 서버 주소.
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FILE_STORAGE_DIR=
PUBLIC_BASE_URL=http://localhost:8080

# 웹 푸시(VAPID): 비워 두면 푸시 발송·스케줄러 꺼짐. 생성(base64url):
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   공개키: openssl ec -in vapid.pem -pubout -outform DER 2>/dev/null | tail -c 65 | base64 | tr '+/' '-_' | tr -d '=\n'
#   비밀키: openssl ec -in vapid.pem -outform DER 2>/dev/null | head -c 39 | tail -c 32 | base64 | tr '+/' '-_' | tr -d '=\n'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ttareureung.store
