
# 프로젝트 루트의 .env로 복사한 뒤 개인 로컬 환경에 맞게 입력합니다.
# 실제 비밀번호와 비밀키는 이 예시 파일에 작성하지 않습니다.

# Database: 실행 중인 MySQL의 DB 이름과 접속 계정에 맞게 수정.
DB_URL=jdbc:mysql://localhost:3306/ttareureung
DB_USERNAME=root
DB_PASSWORD=

# JWT: openssl rand -base64 32로 생성한 비밀키를 입력.
JWT_SECRET=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# CORS: 여러 Origin은 쉼표로 구분.
CORS_ALLOWED_ORIGINS=http://localhost:5173
